# מחרוזת החיבור ל-Neon (עדיף ה-pooled connection string)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# מחרוזת סודית ארוכה ואקראית לחתימת ההתחברות (למשל: openssl rand -base64 32)
AUTH_SECRET=change-me-to-a-long-random-string
# המנהל הראשון נוצר אוטומטית בהפעלה הראשונה, אם עוד אין מנהל במערכת
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
